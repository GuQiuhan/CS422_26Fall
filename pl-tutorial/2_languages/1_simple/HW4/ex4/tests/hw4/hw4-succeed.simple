// Should type check: no variable is declared twice in the SAME block.
int x = 1;

void f(int a) {
  int a = 2;                      // parameter is outside the body block
  for (int i = 0; i < 2; ++i) {   // i lives in the for loop's own block
    int a = i;
  }
  int i = 5;
  { int x = 3; }
  int x = 4;                      // first local x of this block
  try {
    int a = 6;
  } catch(int a) {
    int a = 0;                    // catch parameter is outside the block
  }
}

void main() {
  f(0);
}
